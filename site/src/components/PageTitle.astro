---
// Starlight's page title, with a link to the page's Markdown copy for agents (and people who prefer it).
const PAGE_TITLE_ID = "_top"; // Starlight's id for the page title (not exported)

const { entry, id } = Astro.locals.starlightRoute;
// The API reference's pages are generated from the OpenAPI spec and have no Markdown copy: they link the spec instead.
const api = id?.startsWith("api/v1");
const markdown = id && !api ? `/${id.replace(/\/$/, "")}.md` : null;
---

<h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
{api && (
  <p class="as-markdown">
    <a href="/api/openapi.json">The OpenAPI spec (JSON)</a>
    <span aria-hidden="true">·</span>
    <a href="/api/">Licence, versions and sign-in</a>
  </p>
)}
{markdown && (
  <p class="as-markdown">
    <a href={markdown}>View as Markdown</a>
    <span aria-hidden="true">·</span>
    <a href="/llms-full.txt">All docs in one file</a>
  </p>
)}

<style>
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .as-markdown {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--sl-color-gray-3);
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .as-markdown a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    white-space: nowrap;
  }
  .as-markdown a:hover,
  .as-markdown a:focus-visible {
    color: var(--sl-color-accent);
    text-decoration: underline;
  }
</style>
