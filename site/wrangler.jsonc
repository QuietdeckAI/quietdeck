// quietdeck.ai: the built site served as static assets by Cloudflare Workers. Not deployed yet: no deploy job until
// the domain and the Cloudflare token are set up.
{
  "$schema": "https://unpkg.com/wrangler@4.168.0/config-schema.json",
  "name": "quietdeck-site",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
